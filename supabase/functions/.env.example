# =============================================================================
# Secretos de las Edge Functions (SOLO SERVIDOR) — ejemplo
# -----------------------------------------------------------------------------
# En producción se cargan con:  npx supabase secrets set --env-file supabase/functions/.env
# o desde el panel: Edge Functions → Secrets.
# SUPABASE_URL y las claves de Supabase las inyecta la plataforma automáticamente:
# no es necesario definirlas.
# =============================================================================

# Stripe (modo prueba). Debe empezar con sk_test_ mientras payments.mode = "test".
STRIPE_SECRET_KEY=<sk_test_xxxxxxxxxxxxxxxxxxxx>
# Secreto de firma del endpoint de webhook (Stripe → Developers → Webhooks).
STRIPE_WEBHOOK_SECRET=<whsec_xxxxxxxxxxxxxxxxxxxx>
# Moneda ISO en minúsculas. Verifique en Stripe que su cuenta admite cobrar en ella.
STRIPE_CURRENCY=bob
# Orígenes permitidos para CORS (separados por coma).
ALLOWED_ORIGINS=http://localhost:5173
